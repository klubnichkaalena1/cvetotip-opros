# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель «смотрит фото → отвечает текстом» (не GPT Image / Riverflow — те рисуют картинки).
# Каталог: https://openrouter.ai/google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# Если ошибка про OpenRouter из‑за антivirus/VPN — только локально: OPENROUTER_INSECURE_TLS=1
OPENROUTER_INSECURE_TLS=

PORT=3001
